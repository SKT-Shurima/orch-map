{
  "name": "@orch-map/mapdata",
  "version": "1.0.0",
  "description": "GeoJSON map data and data service for orch-map",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./data/*": "./data/*"
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "compress-json": "node scripts/compress-json.js",
    "merge-geojson": "node scripts/merge-geojson.js"
  },
  "dependencies": {
    "@orch-map/types": "workspace:*"
  },
  "devDependencies": {
    "@turf/turf": "^7.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "geojson",
    "map",
    "data",
    "orch-map",
    "china",
    "world",
    "us"
  ]
}
