{
  "name": "@orch-map/path-adapter",
  "version": "1.0.0",
  "description": "Path adapter for orch-map to access GeoJSON map data (requires @orch-map/geo-json)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@orch-map/types": "workspace:*"
  },
  "devDependencies": {
    "@turf/turf": "^7.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SKT-Shurima/orch-map.git",
    "directory": "packages/path-adapter"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "geojson",
    "map",
    "data",
    "path-adapter",
    "adapter",
    "orch-map",
    "china",
    "world",
    "us"
  ]
}
