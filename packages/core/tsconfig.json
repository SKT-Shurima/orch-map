{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": false,
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/lib": ["./lib"],
      "@orch-map/types": ["../../packages/types/src"],
      "@orch-map/utils": ["../../packages/utils/src"],
      "@orch-map/path-adapter": ["../../packages/path-adapter/src"]
    }
  },
  "include": ["src/**/*", "lib"],
  "exclude": ["dist", "node_modules"]
}
